# Vyntrix local configuration. Copy this file to .env.local to customize it.
# Never commit .env.local or a real secret.

# Local development server (backend/server.js)
PORT=3050

# Optional split deployment: exact browser frontend origin allowed by the backend.
# VYNTRIX_FRONTEND_ORIGIN=https://your-project.vercel.app

# Optional for local development; required when NODE_ENV=production.
# Generate a production value with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-unique-32-character-minimum-secret

# Uncomment only for a production HTTPS deployment.
# NODE_ENV=production

# Optional: store runtime JSON data, alerts, and sessions outside the project.
# VYNTRIX_DATA_DIR=/absolute/path/to/vyntrix-data
# Deprecated compatibility variable; used only when VYNTRIX_DATA_DIR is not set.
# SASTA_CCTV_DATA_DIR=/absolute/path/to/existing-data

# Alert upload protections
# Maximum decoded image size; maximum supported value is 2097152 (2 MB).
# VYNTRIX_ALERT_MAX_IMAGE_BYTES=2097152
# Maximum retained alerts per user. Oldest alerts are removed when the limit is reached.
# VYNTRIX_MAX_ALERTS_PER_USER=100
# Per-user upload rate limit and its rolling window.
# VYNTRIX_ALERT_UPLOAD_LIMIT=60
# VYNTRIX_ALERT_UPLOAD_WINDOW_MS=900000

# WebRTC ICE configuration. STUN is used by default; TURN is optional.
# Use comma- or space-separated URLs. TURN requires both credentials below.
# VYNTRIX_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# VYNTRIX_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VYNTRIX_TURN_USERNAME=replace-with-turn-username
# VYNTRIX_TURN_CREDENTIAL=replace-with-turn-credential
