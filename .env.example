# Vyntrix local configuration. Copy this file to .env.local to customize it.
# Never commit .env.local or a real secret.

# Local development server (backend/server.js)
PORT=3050

# Optional for local development; required when NODE_ENV=production.
# Generate a production value with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-unique-32-character-minimum-secret

# Uncomment only for a production HTTPS deployment.
# NODE_ENV=production

# Optional: store runtime JSON data, alerts, and sessions outside the project.
# VYNTRIX_DATA_DIR=/absolute/path/to/vyntrix-data
# Deprecated compatibility variable; used only when VYNTRIX_DATA_DIR is not set.
# SASTA_CCTV_DATA_DIR=/absolute/path/to/existing-data
